{
  "Jwt": {
    "Key": "change-this-secret-key-must-be-at-least-32-chars",
    "Issuer": "i-like-trains",
    "Audience": "i-like-trains-users",
    "ExpiryHours": 1
  },
  "ThirdPartyChecksums": {
    "yq": "fa52a4e758c63d38299163fbdd1edfb4c4963247918bf9c1c5d31d84789eded4"
  },
  "ConnectionStrings": {
    "Default": "Data Source=app.db"
  },
  "NLog": {
    "targets": {
      "console": {
        "type": "Console",
        "layout": "${msg}"
      }
    },
    "rules": [
      { "logger": "Microsoft.*", "maxLevel": "Info", "final": true },
      { "logger": "System.*",    "maxLevel": "Info", "final": true },
      { "logger": "*",           "minLevel": "Info", "writeTo": "console" }
    ]
  }
}
